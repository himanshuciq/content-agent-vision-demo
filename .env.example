# Slack bot used by the /api/nudge route to DM Mike when Claire clicks "Nudge Mike".
# Bot token needs scopes: chat:write, im:write, users:read (if looking up by email).
SLACK_BOT_TOKEN=
# Mike's Slack member ID (Slack profile -> "Copy member ID"), or look it up via
# users.lookupByEmail if you only have his email.
SLACK_MIKE_USER_ID=
# Michelle's Slack member ID — gets the DM for ops nudges (Nudge Michelle). For a
# self-demo you can set this to your own member ID too.
SLACK_MICHELLE_USER_ID=
